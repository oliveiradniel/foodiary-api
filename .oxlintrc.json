{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-console": "error",
		"eqeqeq": ["error", "always"],
		"typescript/consistent-type-imports": "error"
	},
	"env": {
		"builtin": true
	}
}
